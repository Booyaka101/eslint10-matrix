{
  "name": "eslint10-matrix",
  "version": "1.2.1",
  "description": "Can this repo upgrade to ESLint 10 yet? `scan` executes your own installed plugin versions against ESLint 10 on your own source files. Answers come from execution, not from declared peerDependencies.",
  "keywords": [
    "eslint",
    "eslint10",
    "compatibility",
    "migration",
    "plugins",
    "peerdependencies",
    "upgrade",
    "flat-config",
    "eslint-plugin"
  ],
  "homepage": "https://booyaka101.github.io/eslint10-matrix/",
  "bugs": {
    "url": "https://github.com/Booyaka101/eslint10-matrix/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Booyaka101/eslint10-matrix.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Christiaan Bosch <cbosch101@gmail.com>",
  "type": "module",
  "bin": {
    "eslint10-matrix": "dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "probe",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
