{
  "name": "eslint10-matrix-workspace",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Nightly-executed ESLint 10 compatibility matrix for popular ESLint plugins",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/runner",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/cli && npm run build --workspace packages/runner",
    "run:matrix": "npm run build && node packages/runner/dist/run.js",
    "site": "node site/build.mjs",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.9.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.8"
  }
}
